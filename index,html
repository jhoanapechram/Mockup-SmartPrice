<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>SmartPrice — Tu compra inteligente</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
  body { font-family:'Poppins',sans-serif; margin:0; background:#f8fafc; color:#333; }
  header { position:sticky; top:0; background:#fff; padding:10px 20px; border-bottom:1px solid #ddd; display:flex; justify-content:space-between; align-items:center; }
  .btn-primary { background:#1e88e5; color:white; border:none; border-radius:8px; padding:8px 14px; cursor:pointer; }
  .btn-ghost { background:transparent; border:1px solid #ccc; border-radius:8px; padding:8px 12px; cursor:pointer; }
  .wrap { max-width:1100px; margin:20px auto; padding:0 20px; }
  .card { background:white; border-radius:12px; padding:16px; box-shadow:0 4px 18px rgba(0,0,0,0.05); }
  h2 { margin-top:0; }
  #mapContainer { height:420px; border-radius:12px; overflow:hidden; margin-top:10px; }
  #infoBox { margin-top:10px; font-size:0.9rem; color:#555; }
  .toast { position:fixed; right:20px; bottom:20px; background:white; border-radius:10px; padding:10px 14px; box-shadow:0 4px 20px rgba(0,0,0,0.15); display:none; z-index:2000; }
</style>
</head>

<body>
<header>
  <div style="font-weight:800;font-size:1.2rem;color:#1e88e5;">SmartPrice</div>
  <button class="btn-primary" onclick="initMap()">🗺️ Activar mapa</button>
</header>

<div class="wrap">
  <section id="mapSection">
    <h2>Mapa de Tiendas — SmartPrice</h2>
    <div class="card">
      <div style="display:flex; gap:12px; align-items:center; margin-bottom:12px;">
        <button class="btn-ghost" onclick="useMyLocation()">📍 Usar mi ubicación</button>
        <div id="mapStatus" style="margin-left:auto;font-size:0.9rem;color:#555;">Esperando ubicación...</div>
      </div>
      <div id="mapContainer"></div>
      <div id="infoBox">Selecciona una ubicación para ver distancia y tiempo estimado.</div>
    </div>
  </section>
</div>

<div id="toast" class="toast"></div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
let map, userMarker, line;
const stores = [
  { name:"Walmart Altabrisa", lat:21.0223, lng:-89.5868 },
  { name:"Soriana Montejo", lat:20.9906, lng:-89.6271 },
  { name:"Chedraui Itzaes", lat:20.9691, lng:-89.6412 }
];

// Inicializa el mapa
function initMap() {
  if (map) { showToast("El mapa ya está activo"); return; }
  map = L.map('mapContainer').setView([20.9674, -89.5926], 12);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution:'© OpenStreetMap contributors'
  }).addTo(map);

  stores.forEach(s => {
    const marker = L.marker([s.lat, s.lng]).addTo(map);
    marker.bindPopup(`<b>${s.name}</b><br><button class='btn-ghost' onclick="selectStore(${s.lat},${s.lng},'${s.name}')">Ver distancia</button>`);
  });

  showToast("Mapa cargado correctamente", 2000);
}

function showToast(msg, ms=1600) {
  const t=document.getElementById("toast");
  t.innerText=msg; t.style.display="block";
  clearTimeout(t._timeout);
  t._timeout=setTimeout(()=>t.style.display="none", ms);
}

// Detectar ubicación actual
function useMyLocation() {
  if (!navigator.geolocation) { showToast("Geolocalización no soportada"); return; }
  navigator.geolocation.getCurrentPosition(pos=>{
    const {latitude,longitude} = pos.coords;
    if (userMarker) map.removeLayer(userMarker);
    userMarker = L.marker([latitude,longitude], {
      icon: L.icon({ iconUrl:"https://maps.google.com/mapfiles/ms/icons/red-dot.png", iconSize:[32,32], iconAnchor:[16,32] })
    }).addTo(map).bindPopup("📍 Estás aquí").openPopup();
    map.setView([latitude,longitude], 14);
    document.getElementById("mapStatus").innerText = `Ubicación detectada: ${latitude.toFixed(3)}, ${longitude.toFixed(3)}`;
    showToast("Ubicación actual detectada",1800);
  },()=>showToast("No se pudo acceder a tu ubicación",2000));
}

// Seleccionar tienda y calcular distancia
function selectStore(lat,lng,name) {
  if (!userMarker) { showToast("Primero usa '📍 Usar mi ubicación'"); return; }
  const userPos = userMarker.getLatLng();
  const distance = getDistance(userPos.lat, userPos.lng, lat, lng);
  const speed = 40; // km/h estimado
  const time = (distance / speed) * 60; // minutos
  document.getElementById("infoBox").innerHTML =
    `<b>${name}</b><br>Distancia: ${distance.toFixed(2)} km<br>Tiempo estimado: ${time.toFixed(1)} min`;

  if (line) map.removeLayer(line);
  line = L.polyline([[userPos.lat, userPos.lng],[lat,lng]], {color:'#1e88e5', weight:4}).addTo(map);
  showToast("Ruta en línea recta trazada",1800);
}

// Cálculo de distancia en línea recta (Haversine)
function getDistance(lat1, lon1, lat2, lon2) {
  const R = 6371; // km
  const dLat = (lat2 - lat1) * Math.PI / 180;
  const dLon = (lon2 - lon1) * Math.PI / 180;
  const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
            Math.cos(lat1 * Math.PI/180) * Math.cos(lat2 * Math.PI/180) *
            Math.sin(dLon/2) * Math.sin(dLon/2);
  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
  return R * c;
}
</script>
</body>
</html>
